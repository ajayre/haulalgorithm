<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console runner for the field solver: solves one field with the real engine and
       prints every run. It is the tool for the long acceptance run. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>FieldSolverProof</AssemblyName>
    <RootNamespace>FieldSolverProof</RootNamespace>
    <!-- Every file names its own namespaces; DotNET/Directory.Build.props would switch implicit usings on. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FieldSolver\FieldSolver.csproj" />
    <ProjectReference Include="..\HaulBuilder\HaulBuilder.csproj" />
  </ItemGroup>

</Project>
