<Project Sdk="Microsoft.NET.Sdk">

  <!-- Command-line host for the field solver. The assembly cannot be named
       FieldSolver: that name belongs to the library this program references.
       NameTheFieldSolverHost copies the apphost to FieldSolver.exe. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>FieldSolverCli</AssemblyName>
    <RootNamespace>FieldSolverCli</RootNamespace>
    <Description>FieldSolver.exe: command-line interface for the field solver.</Description>
    <Version>0.0.1</Version>
    <!-- Every file names its own namespaces; DotNET/Directory.Build.props would switch implicit usings on. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NDesk.Options 0.2.1 ships .NET Framework assets. It runs on net8.0; NU1701 only reports the asset target. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <!-- dotnet run must start the renamed host, not FieldSolverCli.exe. -->
    <RunCommand>$(TargetDir)FieldSolver.exe</RunCommand>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NDesk.Options" Version="0.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FieldSolver\FieldSolver.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FieldSolverCli.Tests" />
  </ItemGroup>

  <!-- The apphost is named after the assembly. Copy it to the name operators run. -->
  <Target Name="NameTheFieldSolverHost" AfterTargets="Build">
    <PropertyGroup>
      <_HostSource>$(TargetDir)$(AssemblyName).exe</_HostSource>
      <_HostDest>$(TargetDir)FieldSolver.exe</_HostDest>
    </PropertyGroup>
    <Copy SourceFiles="$(_HostSource)" DestinationFiles="$(_HostDest)" Condition="Exists('$(_HostSource)')" />
    <Delete Files="$(_HostSource)" Condition="Exists('$(_HostSource)') and '$(_HostSource)' != '$(_HostDest)'" />
  </Target>

</Project>
